# Mẫu biến môi trường — copy thành .env cho local, hoặc bơm qua Vault/K8s ở env thật.
# Mọi biến có tiền tố APP_ sẽ override giá trị tương ứng trong config.<env>.yaml.
# Quy tắc: dấu chấm trong key YAML -> gạch dưới. Ví dụ postgres.password -> APP_POSTGRES_PASSWORD.

# Chọn môi trường: local | dev | staging | production
APP_ENV=local

# --- Secret (BẮT BUỘC ở dev/staging/production) ---
APP_POSTGRES_PASSWORD=123456
APP_REDIS_PASSWORD=
APP_RABBITMQ_PASSWORD=app_password
APP_MINIO_SECRET_KEY=minioadmin
APP_JWT_SECRET=doi-secret-nay-o-moi-truong-that

# --- Override tùy chọn (ví dụ) ---
# APP_HTTP_API_PORT=8080
# APP_LOG_LEVEL=debug
# APP_TELEMETRY_TRACING_ENABLED=true
# APP_STORAGE_DRIVER=filesystem
# APP_STORAGE_FILESYSTEM_ROOT=./var/storage
# RAGFlow HTTP API (secret chỉ đặt trong .env/secret manager)
# Đổi thành true sau khi thay API key thật.
APP_RAGFLOW_ENABLED=false
APP_RAGFLOW_BASE_URL=https://ragflow.io.vn
APP_RAGFLOW_API_KEY=ragflow-replace-me
APP_RAGFLOW_DATASET_PREFIX=docs_hub_local
APP_RAGFLOW_TIMEOUT=30s
APP_RAGFLOW_UPLOAD_TIMEOUT=2m
APP_RAGFLOW_POLL_INTERVAL=3s
APP_RAGFLOW_MAX_POLL_DURATION=15m
