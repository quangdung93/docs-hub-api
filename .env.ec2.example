# Mẫu biến môi trường cho stack EC2 (deployments/ec2/docker-compose.yml).
# Trên EC2: cp .env.ec2.example .env.ec2 rồi điền giá trị thật. KHÔNG commit .env.ec2.
#
# Sinh nhanh một secret ngẫu nhiên: openssl rand -base64 32

# --- Hạ tầng chạy cùng máy (đặt gì cũng được, nhưng phải đủ mạnh) ---
APP_POSTGRES_PASSWORD=
APP_REDIS_PASSWORD=
APP_RABBITMQ_PASSWORD=
# MinIO yêu cầu tối thiểu 8 ký tự.
APP_MINIO_SECRET_KEY=

# --- Ứng dụng ---
APP_JWT_SECRET=
