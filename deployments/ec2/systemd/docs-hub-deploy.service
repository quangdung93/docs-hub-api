# Một lượt kiểm tra + deploy docs-hub (xem deployments/ec2/deploy.sh).
# Cài: xem mục "Tự động deploy" trong deployments/ec2/README.md.
[Unit]
Description=docs-hub: deploy khi main có commit mới
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# User ubuntu thuộc group docker và sở hữu /home/web; .env.ec2 để chmod 600 cho user này.
User=ubuntu
ExecStart=/home/web/docs-hub-api/deployments/ec2/deploy.sh
# Build Next.js trên máy 2 vCPU có thể mất vài phút.
TimeoutStartSec=30min
